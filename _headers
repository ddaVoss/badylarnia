# Nagłówki bezpieczeństwa HTTP dla hostingu Netlify.
# Ten plik działa automatycznie, jeśli wgracie stronę na Netlify — nic nie
# trzeba dodatkowo konfigurować. (Dla Apache/FTP jest .htaccess,
# dla Vercela — vercel.json; oba dają ten sam efekt).

/*
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self'; connect-src 'self' https://places.googleapis.com; frame-src https://www.google.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'; upgrade-insecure-requests
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
